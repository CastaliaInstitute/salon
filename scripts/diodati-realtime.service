[Unit]
Description=Villa Diodati realtime Matrix salon
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diodati
Group=diodati
EnvironmentFile=/etc/diodati-realtime.env
ExecStart=/usr/bin/python3 /opt/diodati-realtime/diodati_realtime.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/diodati-realtime

[Install]
WantedBy=multi-user.target
