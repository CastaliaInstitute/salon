# Optional — defaults shown in src/lib/matrix-room-client.ts
# PUBLIC_MATRIX_SERVER=https://matrix.castalia.institute

# Required only if guests send messages via matrix-send-message edge function
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=

# Optional room director adapter. This must be a server/edge endpoint that
# holds the Google AI Studio/Gemini key and returns salon_actions_v1 JSON.
# Never put GEMINI_API_KEY in this file or in browser code.
# PUBLIC_SALON_DIRECTOR_URL=https://<project>.supabase.co/functions/v1/salon-director

# Required for member salon entry (/villa/enter/): Supabase OAuth sign-in and
# the villa-diodati-chat edge function. Publishable anon key only — no secrets.
# Without both vars the entry page renders a "Salon entry is not configured" notice.
