---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const viewerQuery = Astro.url.search;
---

<BaseLayout
  title="Villa Diodati · 2.5D"
  description="A Matrix-backed isometric view of the Villa Diodati salon."
>
  <iframe
    title="Villa Diodati isometric Three.js salon"
    src={`/worlds/villa-diodati/sprite-room/${viewerQuery ? `?${viewerQuery.slice(1)}` : ''}`}
    class="sprite-room-frame"
    allow="fullscreen"
  ></iframe>
</BaseLayout>

<script>
  document.body.classList.add('immersive-salon');
</script>

<style is:global>
  body.immersive-salon nav,
  body.immersive-salon .site-footer {
    display: none;
  }
  body.immersive-salon { margin: 0; overflow: hidden; }
  .sprite-room-frame { display: block; width: 100%; height: 100dvh; border: 0; background: #17120f; }
</style>
