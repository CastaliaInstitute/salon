---
import '../styles/global.css';
import CastaliaShell from '../components/CastaliaShell.tsx';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Replayable evening salons: a host, invited guests, and conversation.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const baseWithSlash = `${base}/`;
const path = Astro.url.pathname;
const pageTitle = `${title} | Salon`;
const normalizeSitePath = (value: string) => {
  const normalized = value.replace(/\/+$/, '');
  return normalized || '/';
};
const isHomePage = normalizeSitePath(path) === '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow" />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href={`${baseWithSlash}favicon.svg`}>
</head>
<body>
  <CastaliaShell isHomePage={isHomePage}>
    <div class="salon-stack">
      <slot />
      <footer class="site-footer salon-cc">
        <div class="container">
          <p class="text-muted" style="margin-top: 0.5rem; font-size: 0.85rem;">
            Licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>
          </p>
        </div>
      </footer>
    </div>
  </CastaliaShell>
</body>
</html>
