---
import '../styles/global.css';
import CastaliaShell from '../components/CastaliaShell.tsx';
import SalonSWRegistry from '../components/SalonSWRegistry.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Replayable evening salons: a host, invited guests, and conversation.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const baseWithSlash = `${base}/`;
const path = Astro.url.pathname;
const pageTitle = `${title} | Salon`;
const isPublicPath = path === '/' || path.startsWith('/diodati') || path.startsWith('/live');
const isHomePage = path === '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content={description}>
  <meta name="robots" content={isPublicPath ? 'index, follow' : 'noindex, nofollow'} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href={`${baseWithSlash}favicon.svg`}>
  <link rel="manifest" href={`${baseWithSlash}manifest.webmanifest`}>
  <meta name="theme-color" content="#1e1a16">
  <link rel="apple-touch-icon" href={`${baseWithSlash}icons/icon-192.png`}>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Salon">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
</head>
<body>
  <CastaliaShell client:load isHomePage={isHomePage}>
    <div class="salon-stack">
      <slot />
      <footer class="site-footer salon-cc">
        <div class="container">
          <p class="text-muted" style="margin-top: 0.5rem; font-size: 0.85rem;">
            Licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>
          </p>
        </div>
      </footer>
    </div>
  </CastaliaShell>
  <SalonSWRegistry />
</body>
</html>
